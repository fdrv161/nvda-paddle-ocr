msgid ""
msgstr ""
"Project-Id-Version: paddleOcr\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Paddle OCR"
msgstr "Paddle OCR"

msgid "Follow NVDA language ({language})"
msgstr "По языку NVDA ({language})"

msgid "Recognition &mode:"
msgstr "&Режим распознавания:"

msgid "&Letters of all Cyrillic alphabets in the Cyrillic mode"
msgstr "&Буквы всех кириллических алфавитов в режиме «Кириллица»"

msgid "Periodically &refresh recognized content"
msgstr "Периодически &обновлять распознанное содержимое"

msgid "Automatically &say all when recognition finishes"
msgstr "&Читать всё после распознавания"

msgid "Recognizes the content of the current navigator object with Paddle OCR"
msgstr "Распознаёт содержимое текущего объекта навигатора с помощью Paddle OCR"

msgid "Recognizes the content of the foreground window with Paddle OCR"
msgstr "Распознаёт содержимое активного окна с помощью Paddle OCR"

msgid "Recognizes the whole screen with Paddle OCR"
msgstr "Распознаёт весь экран с помощью Paddle OCR"

msgid "Recognizes the image on the clipboard with Paddle OCR"
msgstr "Распознаёт картинку из буфера обмена с помощью Paddle OCR"

msgid "There is no image or image file on the clipboard"
msgstr "В буфере обмена нет картинки или файла с картинкой"

msgid "Recognition failed"
msgstr "Распознавание не удалось"

msgid "No text found"
msgstr "Текст не найден"

msgid "Paddle OCR: clipboard image"
msgstr "Paddle OCR: картинка из буфера обмена"

msgid "Cycles the Paddle OCR recognition mode"
msgstr "Переключает режим распознавания Paddle OCR"

msgid "Shows the Paddle OCR settings"
msgstr "Открывает настройки Paddle OCR"

msgid "Latin"
msgstr "Латиница"

msgid "Cyrillic"
msgstr "Кириллица"

msgid "Loading OCR models"
msgstr "Загрузка моделей OCR"

msgid ""
"Microsoft Visual C++ Redistributable x64 is missing. Install it from the "
"Microsoft website and restart NVDA"
msgstr ""
"Не хватает пакета Microsoft Visual C++ Redistributable x64. Установите его с "
"сайта Microsoft и перезапустите NVDA"

msgid "Recognition in progress"
msgstr "Распознавание уже идёт"

msgid ""
"The previous recognition did not finish in {seconds} seconds, starting "
"again. If it hangs again, restart NVDA"
msgstr ""
"Предыдущее распознавание не закончилось за {seconds} секунд, начинаю "
"заново. Если зависнет снова, перезапустите NVDA"
